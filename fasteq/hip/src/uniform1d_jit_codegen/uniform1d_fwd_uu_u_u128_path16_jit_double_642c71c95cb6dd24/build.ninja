ninja_required_version = 1.3
cxx = c++
nvcc = /opt/dtk/bin/hipcc

cflags = -DTORCH_EXTENSION_NAME=uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24 -DTORCH_API_INCLUDE_EXTENSION_H -I/repos/FastEq/fasteq/hip/src -isystem /usr/local/lib/python3.11/site-packages/torch/include -isystem /usr/local/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/lib/python3.11/site-packages/torch/include/THH -isystem /opt/dtk/include -isystem /usr/local/include/python3.11 -fPIC -std=c++17 -O3
post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC
cuda_cflags = -DWITH_HIP -DTORCH_EXTENSION_NAME=uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24 -DTORCH_API_INCLUDE_EXTENSION_H -I/repos/FastEq/fasteq/hip/src -isystem /usr/local/lib/python3.11/site-packages/torch/include -isystem /usr/local/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/lib/python3.11/site-packages/torch/include/THH -isystem /opt/dtk/include -isystem /usr/local/include/python3.11 -fPIC -std=c++17 -O3 -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -DHIP_ENABLE_WARP_SYNC_BUILTINS=1 --offload-arch=gfx906 --offload-arch=gfx926 --offload-arch=gfx928 --offload-arch=gfx936 --offload-arch=gfx938 -fno-gpu-rdc -O3 --offload-arch=gfx936
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/usr/local/lib/python3.11/site-packages/torch/lib -lc10 -lc10_hip -ltorch_cpu -ltorch_hip -ltorch -ltorch_python -L/opt/dtk/lib -lamdhip64

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24.cuda.o: cuda_compile /repos/FastEq/fasteq/hip/src/uniform1d_jit_codegen/uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24/uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24.hip





build uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24.so: link uniform1d_fwd_uu_u_u128_path16_jit_double_642c71c95cb6dd24.cuda.o

