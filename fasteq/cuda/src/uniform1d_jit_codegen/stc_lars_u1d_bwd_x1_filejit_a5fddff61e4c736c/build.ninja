ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1016\" -isystem /home/malixian/miniconda3/envs/fasteq/lib/python3.10/site-packages/torch/include -isystem /home/malixian/miniconda3/envs/fasteq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/malixian/miniconda3/envs/fasteq/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=1 -fPIC -std=c++17 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1016\" -isystem /home/malixian/miniconda3/envs/fasteq/lib/python3.10/site-packages/torch/include -isystem /home/malixian/miniconda3/envs/fasteq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/malixian/miniconda3/envs/fasteq/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -O3 --ptxas-options=-v -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/malixian/miniconda3/envs/fasteq/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c.cuda.o: cuda_compile /home/malixian/repos/FastEq/fasteq/cuda/src/uniform1d_jit_codegen/stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c/stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c.cu





build stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c.so: link stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c.cuda.o

default stc_lars_u1d_bwd_x1_filejit_a5fddff61e4c736c.so
