LAMMPS (30 Mar 2026 - Development - patch_30Mar2026-385-g704e0160b4)
KOKKOS mode with Kokkos version 5.1.99 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# 300 K preheat + production MD from the relaxed cubic MgO reference state (~4k atoms)

units          metal
atom_style     atomic
boundary       p p p
atom_modify    map yes
newton         on

variable       datafile string /home/malixian/repos/FastEq/test/nequip_allegro_test/data/cubic/MgO_cubic_t4000_n4096_r8x8x8.relaxed.data
variable       modelfile string /home/malixian/repos/FastEq/test/nequip_allegro_test/lammps_models/fasteq-mir-group__Allegro-OAM-L__0.1.nequip.lmp.pt
variable       preheat_steps equal 20
variable       runsteps equal 200
variable       timestep_fs equal 0.001
variable       temperature equal 300.0

read_data      ${datafile}
read_data      /home/malixian/repos/FastEq/test/nequip_allegro_test/data/cubic/MgO_cubic_t4000_n4096_r8x8x8.relaxed.data
Reading data file ...
  orthogonal box = (-1.1994069 -1.1994069 -1.1994069) to (32.857631 32.857631 32.857631)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  4096 atoms
  reading velocities ...
  4096 velocities
  read_data CPU = 0.082 seconds

neighbor       1.0 bin
neigh_modify   every 1 delay 0 check yes

pair_style     mliap unified ${modelfile} 0
pair_style     mliap unified /home/malixian/repos/FastEq/test/nequip_allegro_test/lammps_models/fasteq-mir-group__Allegro-OAM-L__0.1.nequip.lmp.pt 0
pair_coeff     * * Mg O

thermo         10
thermo_style   custom step temp pe etotal press vol spcpu atoms
timestep       ${timestep_fs}
timestep       0.001

velocity       all create ${temperature} 4928459 rot yes dist gaussian
velocity       all create 300 4928459 rot yes dist gaussian
fix            1 all nvt temp ${temperature} ${temperature} 0.02
fix            1 all nvt temp 300 ${temperature} 0.02
fix            1 all nvt temp 300 300 0.02

run            ${preheat_steps}
run            20

