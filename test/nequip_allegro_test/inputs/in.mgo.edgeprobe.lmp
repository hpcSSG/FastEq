units          metal
atom_style     atomic
boundary       p p p
atom_modify    map yes
newton         on

variable       datafile string /home/zhouxibo/lmp_single/MgO/cubic/MgO_cubic_t1000_n1000_r5x5x5.relaxed.data
variable       modelfile string /home/zhouxibo/lmp_single/models/deployed_serial_mliap.pt

read_data      ${datafile}

neighbor       1.0 bin
neigh_modify   every 1 delay 0 check yes

pair_style     mliap unified ${modelfile} 0
pair_coeff     * * Mg O

thermo         1
thermo_style   custom step temp pe etotal press vol atoms
timestep       0.001

run            0
