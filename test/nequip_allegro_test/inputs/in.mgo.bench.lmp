units          metal
atom_style     atomic
boundary       p p p
atom_modify    map yes
newton         on

variable       datafile string /home/zhouxibo/lmp_single/MgO/cubic/MgO_cubic_t1000_n1000_r5x5x5.relaxed.data
variable       modelfile string /home/zhouxibo/lmp_single/models/deployed_serial_mliap.pt
variable       preheat_steps equal 20
variable       runsteps equal 50
variable       timestep_fs equal 0.001
variable       temperature equal 300.0

read_data      ${datafile}

neighbor       1.0 bin
neigh_modify   every 1 delay 0 check yes

pair_style     mliap unified ${modelfile} 0
pair_coeff     * * Mg O

thermo         10
thermo_style   custom step temp pe etotal press vol spcpu atoms
timestep       ${timestep_fs}

velocity       all create ${temperature} 4928459 rot yes dist gaussian
fix            1 all nvt temp ${temperature} ${temperature} 0.02

run            ${preheat_steps}

unfix          1
reset_timestep 0
fix            2 all nvt temp ${temperature} ${temperature} 0.1

run            ${runsteps}
